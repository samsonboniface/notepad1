{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Notepad web server",
            "type": "process",
            "command": "python",
            "args": [
                "-m",
                "http.server",
                "8080",
                "--bind",
                "127.0.0.1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "notepad-server",
                "pattern": {
                    "regexp": "^(.*)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*$",
                    "endsPattern": "^Serving HTTP on"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            }
        }
    ]
}
